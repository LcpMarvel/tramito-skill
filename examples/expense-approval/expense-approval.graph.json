      "target": "task_6"
    },
    {
      "id": "flow_15",
      "source": "task_6",
      "target": "task_7"
    },
    {
      "id": "flow_16",
      "source": "task_7",
      "target": "gateway_8"
    },
    {
      "id": "flow_17",
      "source": "gateway_8",
      "target": "task_9",

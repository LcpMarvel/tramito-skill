        <dc:Bounds x="668" y="151" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_4_di" bpmnElement="lane_4" isHorizontal="true">
        <dc:Bounds x="30" y="247" width="1184" height="251" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_11_di" bpmnElement="gateway_11">
        <dc:Bounds x="848" y="281" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="831" y="263" width="84" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_10_di" bpmnElement="task_10">
        <dc:Bounds x="978" y="266" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_12_di" bpmnElement="task_12">

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-elk-layout" exporterVersion="1.0.0">
  <bpmn:collaboration id="collaboration_1">
    <bpmn:participant id="pool_1" name="公司" processRef="pool_1_process" />
  </bpmn:collaboration>
  <bpmn:process id="pool_1_process" name="公司" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="lane_2" name="申请人">
        <bpmn:flowNodeRef>start_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_3" name="审批人">
        <bpmn:flowNodeRef>task_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_9</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_4" name="财务">
        <bpmn:flowNodeRef>gateway_11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_13</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_5" name="提交报销">
      <bpmn:outgoing>flow_14</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_6" name="填写报销单">
      <bpmn:incoming>flow_14</bpmn:incoming>
      <bpmn:incoming>flow_23</bpmn:incoming>
      <bpmn:outgoing>flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_7" name="经理审批">
      <bpmn:incoming>flow_15</bpmn:incoming>
      <bpmn:outgoing>flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gateway_8" name="金额是否超过5000元" default="flow_18">
      <bpmn:incoming>flow_16</bpmn:incoming>
      <bpmn:outgoing>flow_17</bpmn:outgoing>
      <bpmn:outgoing>flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_9" name="总经理审批">
      <bpmn:incoming>flow_17</bpmn:incoming>
      <bpmn:outgoing>flow_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gateway_11" name="材料是否齐全" default="flow_22">
      <bpmn:incoming>flow_18</bpmn:incoming>
      <bpmn:incoming>flow_19</bpmn:incoming>
      <bpmn:outgoing>flow_20</bpmn:outgoing>
      <bpmn:outgoing>flow_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="task_10" name="财务打款">
      <bpmn:incoming>flow_20</bpmn:incoming>
      <bpmn:outgoing>flow_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="task_12" name="通知补材料">
      <bpmn:incoming>flow_22</bpmn:incoming>
      <bpmn:outgoing>flow_23</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="end_13" name="报销完成">
      <bpmn:incoming>flow_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_14" sourceRef="start_5" targetRef="task_6" />
    <bpmn:sequenceFlow id="flow_15" sourceRef="task_6" targetRef="task_7" />
    <bpmn:sequenceFlow id="flow_16" sourceRef="task_7" targetRef="gateway_8" />
    <bpmn:sequenceFlow id="flow_17" name="超过5000元" sourceRef="gateway_8" targetRef="task_9">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount &gt; 5000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_18" name="不超过5000元" sourceRef="gateway_8" targetRef="gateway_11" />
    <bpmn:sequenceFlow id="flow_19" sourceRef="task_9" targetRef="gateway_11" />
    <bpmn:sequenceFlow id="flow_20" name="材料齐全" sourceRef="gateway_11" targetRef="task_10">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${docsComplete}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_21" sourceRef="task_10" targetRef="end_13" />
    <bpmn:sequenceFlow id="flow_22" name="缺材料" sourceRef="gateway_11" targetRef="task_12" />
    <bpmn:sequenceFlow id="flow_23" sourceRef="task_12" targetRef="task_6" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_definitions_1" name="BPMNDiagram">
    <bpmndi:BPMNPlane id="BPMNPlane_definitions_1" bpmnElement="collaboration_1">

        <di:waypoint x="98" y="76" />
        <di:waypoint x="178" y="76" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_15_di" bpmnElement="flow_15">
        <di:waypoint x="228" y="116" />
        <di:waypoint x="228" y="191" />
        <di:waypoint x="358" y="191" />
      </bpmndi:BPMNEdge>

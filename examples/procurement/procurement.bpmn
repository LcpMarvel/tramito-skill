<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-elk-layout" exporterVersion="1.0.0">
  <bpmn:process id="process_root" name="流程" isExecutable="true">
    <bpmn:startEvent id="start_1" name="提出物料需求">
      <bpmn:outgoing>flow_10</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="gate_2" name="库存是否充足" default="flow_9">
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_3" name="仓库领用">
      <bpmn:incoming>flow_11</bpmn:incoming>
      <bpmn:outgoing>flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_4" name="创建采购单">
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:incoming>flow_17</bpmn:incoming>
      <bpmn:outgoing>flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_5" name="到货验收">
      <bpmn:incoming>flow_14</bpmn:incoming>
      <bpmn:outgoing>flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gate_6" name="验收是否合格" default="flow_13">
      <bpmn:incoming>flow_15</bpmn:incoming>
      <bpmn:outgoing>flow_16</bpmn:outgoing>
      <bpmn:outgoing>flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="task_7" name="办理退货">
      <bpmn:incoming>flow_13</bpmn:incoming>
      <bpmn:outgoing>flow_17</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="end_8" name="需求满足">
      <bpmn:incoming>flow_12</bpmn:incoming>
      <bpmn:incoming>flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_10" sourceRef="start_1" targetRef="gate_2" />
    <bpmn:sequenceFlow id="flow_11" name="充足" sourceRef="gate_2" targetRef="task_3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${stockEnough}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_9" name="不足" sourceRef="gate_2" targetRef="task_4" />
    <bpmn:sequenceFlow id="flow_12" sourceRef="task_3" targetRef="end_8" />
    <bpmn:sequenceFlow id="flow_14" sourceRef="task_4" targetRef="task_5" />
    <bpmn:sequenceFlow id="flow_15" sourceRef="task_5" targetRef="gate_6" />
    <bpmn:sequenceFlow id="flow_16" name="合格" sourceRef="gate_6" targetRef="end_8">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${passed}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_13" name="不合格" sourceRef="gate_6" targetRef="task_7" />
    <bpmn:sequenceFlow id="flow_17" sourceRef="task_7" targetRef="task_4" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_definitions_1" name="BPMNDiagram">
    <bpmndi:BPMNPlane id="BPMNPlane_definitions_1" bpmnElement="process_root">

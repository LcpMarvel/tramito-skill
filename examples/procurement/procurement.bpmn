          <dc:Bounds x="722" y="205" width="84" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_7_di" bpmnElement="task_7">
        <dc:Bounds x="798" y="234.66666666666669" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_8_di" bpmnElement="end_8">
        <dc:Bounds x="798" y="119.83333333333334" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="788" y="159.83333333333334" width="56" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_10_di" bpmnElement="flow_10">
        <di:waypoint x="98" y="193.83333333333334" />
        <di:waypoint x="178" y="193.83333333333334" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_11_di" bpmnElement="flow_11">
        <di:waypoint x="203" y="168.83333333333334" />

  <bpmn:collaboration id="collaboration_1">
    <bpmn:participant id="pool_1" name="公司" processRef="pool_1_process" />
  </bpmn:collaboration>
  <bpmn:process id="pool_1_process" name="公司" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="lane_2" name="HR">
        <bpmn:flowNodeRef>start_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gate_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gate_10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_12</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_3" name="IT">
        <bpmn:flowNodeRef>task_8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_4" name="行政">
        <bpmn:flowNodeRef>task_9</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_5" name="发出入职通知">
      <bpmn:outgoing>flow_13</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_6" name="HR审核入职材料">
      <bpmn:incoming>flow_13</bpmn:incoming>
      <bpmn:outgoing>flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="gate_7" name="并行准备">
      <bpmn:incoming>flow_14</bpmn:incoming>
      <bpmn:outgoing>flow_15</bpmn:outgoing>
      <bpmn:outgoing>flow_16</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="gate_10" name="等待全部完成">
      <bpmn:incoming>flow_17</bpmn:incoming>
      <bpmn:incoming>flow_18</bpmn:incoming>
      <bpmn:outgoing>flow_19</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="task_11" name="通知员工报到">
      <bpmn:incoming>flow_19</bpmn:incoming>
      <bpmn:outgoing>flow_20</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="end_12" name="入职完成">
      <bpmn:incoming>flow_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="task_8" name="IT开通账号">
      <bpmn:incoming>flow_15</bpmn:incoming>
      <bpmn:outgoing>flow_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="task_9" name="行政配置工位">
      <bpmn:incoming>flow_16</bpmn:incoming>
      <bpmn:outgoing>flow_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow_13" sourceRef="start_5" targetRef="task_6" />
    <bpmn:sequenceFlow id="flow_14" sourceRef="task_6" targetRef="gate_7" />
    <bpmn:sequenceFlow id="flow_15" sourceRef="gate_7" targetRef="task_8" />
    <bpmn:sequenceFlow id="flow_16" sourceRef="gate_7" targetRef="task_9" />
    <bpmn:sequenceFlow id="flow_17" sourceRef="task_8" targetRef="gate_10" />
    <bpmn:sequenceFlow id="flow_18" sourceRef="task_9" targetRef="gate_10" />
    <bpmn:sequenceFlow id="flow_19" sourceRef="gate_10" targetRef="task_11" />
    <bpmn:sequenceFlow id="flow_20" sourceRef="task_11" targetRef="end_12" />
  </bpmn:process>

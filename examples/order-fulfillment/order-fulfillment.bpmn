<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-elk-layout" exporterVersion="1.0.0">
  <bpmn:collaboration id="collaboration_1">
    <bpmn:participant id="pool_1" name="客户" processRef="pool_1_process" />
    <bpmn:participant id="pool_2" name="商家" processRef="pool_2_process" />
    <bpmn:participant id="pool_3" name="第三方物流" />
    <bpmn:messageFlow id="flow_15" sourceRef="task_6" targetRef="start_12" />
    <bpmn:messageFlow id="flow_21" name="委托配送" sourceRef="task_9" targetRef="pool_3" />
    <bpmn:messageFlow id="flow_22" sourceRef="pool_3" targetRef="task_20" />
  </bpmn:collaboration>
  <bpmn:process id="pool_1_process" name="客户" isExecutable="true">
    <bpmn:startEvent id="start_4" name="需要购买商品">
      <bpmn:outgoing>flow_13</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_5" name="浏览并下单">
      <bpmn:incoming>flow_13</bpmn:incoming>
      <bpmn:outgoing>flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="task_6" name="支付订单">
      <bpmn:incoming>flow_14</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:receiveTask id="task_20" name="签收商品">
      <bpmn:outgoing>flow_23</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="end_10" name="收到商品">
      <bpmn:incoming>flow_23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_13" sourceRef="start_4" targetRef="task_5" />
    <bpmn:sequenceFlow id="flow_14" sourceRef="task_5" targetRef="task_6" />
    <bpmn:sequenceFlow id="flow_23" sourceRef="task_20" targetRef="end_10" />
  </bpmn:process>
  <bpmn:process id="pool_2_process" name="商家" isExecutable="true">
    <bpmn:startEvent id="start_12" name="收到新订单">
      <bpmn:outgoing>flow_16</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:receiveTask id="task_7" name="确认订单">
      <bpmn:incoming>flow_16</bpmn:incoming>
      <bpmn:outgoing>flow_17</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="task_8" name="备货">
      <bpmn:incoming>flow_17</bpmn:incoming>
      <bpmn:outgoing>flow_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="task_9" name="发货">
      <bpmn:incoming>flow_18</bpmn:incoming>
      <bpmn:outgoing>flow_19</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="end_11" name="订单完成">
      <bpmn:incoming>flow_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_16" sourceRef="start_12" targetRef="task_7" />
    <bpmn:sequenceFlow id="flow_17" sourceRef="task_7" targetRef="task_8" />
    <bpmn:sequenceFlow id="flow_18" sourceRef="task_8" targetRef="task_9" />
    <bpmn:sequenceFlow id="flow_19" sourceRef="task_9" targetRef="end_11" />
  </bpmn:process>
